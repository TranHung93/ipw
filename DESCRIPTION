Package: ipw
Version: 1.3.2.9000
Date: 2026-10-31
Title: Estimate Inverse Probability Weights
Authors@R: c(
    person(c("Hung", "Thai"), "Tran", role = c("aut", "cre"), email = "hungtt@oucru.org"),
